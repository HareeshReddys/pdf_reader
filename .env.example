OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-6-luna
# Continuous speech-to-speech voice and optional image context:
OPENAI_REALTIME_MODEL=gpt-realtime
# Continuous voice listens to speaker audio and returns text only.
LOCAL_TRANSCRIPTION_MODEL=onnx-community/whisper-base.en
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Codex uses your existing ChatGPT sign-in. Run codex login first.
CODEX_ENABLED=true
# Optional absolute executable path and model override:
# CODEX_CLI_PATH=/path/to/codex
CODEX_MODEL=gpt-6-luna
# Fast mode uses more of your ChatGPT allowance. Set false for Standard.
CODEX_FAST_MODE=true
# Brief streams a direct answer first (100–160 words); detailed restores longer answers.
CODEX_ANSWER_STYLE=brief

# Persistent streamed connection is the default; older CLIs can use exec.
CODEX_TRANSPORT=app-server

# Optional Windows speaker-assistant bridge to the open ChatGPT desktop chat.
# See docs/chatgpt-desktop.md. Other question/screen actions still use Codex.
# ANSWER_PROVIDER=chatgpt-desktop
